# Database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-domain.com"

# Admin credentials (used only in seed)
ADMIN_EMAIL="admin@emergenzasicilia.it"
ADMIN_PASSWORD="change-me-in-production"

# Ingestion secret (GitHub Actions)
INGEST_SECRET="generate-with-openssl-rand-base64-32"

# VAPID keys for Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_CONTACT="mailto:info@emergenzasicilia.it"

# Vercel Blob (for media uploads)
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# WordPress.com site URL
WORDPRESS_SITE_URL="https://public-api.wordpress.com/wp/v2/sites/yoursitename.wordpress.com"

# Base URL for SEO
NEXT_PUBLIC_BASE_URL="https://emergenzasicilia.it"

# GitHub Actions secrets (reference only)
# INGEST_SECRET = same as above
# DATABASE_URL = same as above
